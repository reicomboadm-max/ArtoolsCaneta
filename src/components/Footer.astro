---
// Footer.astro
---
<footer class="relative z-10 py-16 px-6 sm:px-12 md:px-16 bg-[#EAEAE5] dark:bg-[#10100E] border-t border-stone-300 dark:border-stone-800 transition-colors">
    
    <div class="max-w-7xl mx-auto space-y-12">
        
        <!-- Top 3-Columns Grid -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 border-b border-stone-300 dark:border-stone-800 pb-12 items-start">
            
            <!-- Coluna 1: Identidade & Resumo -->
            <div class="md:col-span-5 space-y-3.5 text-left">
                <div class="flex items-center gap-2.5">
                    <iconify-icon class="text-xl text-[#1C1917] dark:text-teal-400" icon="solar:pen-bold"></iconify-icon>
                    <span class="font-bold tracking-tight text-base font-display text-[#1C1917] dark:text-white">
                        ARTOOLS<span class="text-stone-700 dark:text-teal-400 font-normal">.PIGMENTUM</span>
                    </span>
                </div>
                <p class="text-xs sm:text-sm text-stone-700 dark:text-stone-300 max-w-sm leading-relaxed font-sans">
                    Instrumentos de desenho técnico com calibração suíça. Desenvolvido sob diretrizes estéticas e arquiteturais de alta precisão.
                </p>
            </div>

            <!-- Coluna 2: Navegação Rápida -->
            <div class="md:col-span-4 space-y-3 text-left">
                <span class="text-xs font-mono uppercase tracking-widest text-[#1C1917] dark:text-white font-bold block">
                    Navegação do Projeto
                </span>
                <ul class="text-xs font-mono space-y-2 text-stone-700 dark:text-stone-300">
                    <li>
                        <a href="/" class="hover:text-[#1C1917] dark:hover:text-teal-400 transition-colors flex items-center gap-1.5 font-medium">
                            <span class="text-stone-600 dark:text-stone-400 font-bold">01.</span> Início // Visão Geral
                        </a>
                    </li>
                    <li>
                        <a href="/catalogo" class="hover:text-[#1C1917] dark:hover:text-teal-400 transition-colors flex items-center gap-1.5 font-medium">
                            <span class="text-stone-600 dark:text-stone-400 font-bold">02.</span> Catálogo // 09 Modelos
                        </a>
                    </li>
                    <li>
                        <a href="/produtos/0.1" class="hover:text-[#1C1917] dark:hover:text-teal-400 transition-colors flex items-center gap-1.5 font-medium">
                            <span class="text-stone-600 dark:text-stone-400 font-bold">03.</span> Detalhes // Especificações
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Coluna 3: Telemetria & Fuso Horário -->
            <div class="md:col-span-3 text-left md:text-right space-y-3">
                <span class="text-xs font-mono uppercase tracking-widest text-[#1C1917] dark:text-white font-bold block">
                    Telemetria & Fuso
                </span>
                <div class="text-xs font-mono text-stone-700 dark:text-stone-300 space-y-1.5">
                    <div id="live-swiss-clock" class="text-sm font-bold font-mono text-[#1C1917] dark:text-teal-400">
                        GENÈVE 12:00:00 CET
                    </div>
                    <div class="text-[11px] text-stone-700 dark:text-stone-300">PRECISION PROTOCOL // 60 FPS</div>
                    <div class="inline-flex items-center gap-1.5 text-emerald-800 dark:text-emerald-400 text-[11px] font-bold">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 dark:bg-emerald-500 animate-pulse"></span>
                        SISTEMA OPERACIONAL
                    </div>
                </div>
            </div>

        </div>

        <!-- Linha de Copyright & Especificação -->
        <div class="flex flex-col sm:flex-row justify-between items-center text-xs font-mono text-stone-700 dark:text-stone-300 gap-4">
            <div>© 2026 ARTOOLS PIGMENTUM. TODOS OS DIREITOS RESERVADOS.</div>
            <div class="uppercase tracking-wider text-[11px] text-stone-700 dark:text-stone-300">SWISS CALIBER SPECIFICATION // 0.1MM</div>
        </div>

        <!-- Marca d'Água Discreta e Minimalista: Portfólio -->
        <div class="text-center pt-4 pb-2 select-none overflow-hidden" aria-hidden="true">
            <span class="text-2xl sm:text-3xl md:text-4xl font-bold font-display uppercase tracking-[0.35em] text-stone-700/30 dark:text-white/20 transition-colors">
                Portfólio
            </span>
        </div>

    </div>

</footer>

<script is:inline>
    // Live Geneva Clock Update
    function updateSwissClock() {
        const clockEl = document.getElementById('live-swiss-clock');
        if (clockEl) {
            const now = new Date();
            const timeStr = now.toLocaleTimeString('pt-BR', { timeZone: 'Europe/Zurich', hour12: false });
            clockEl.textContent = `GENÈVE ${timeStr} CET`;
        }
    }
    setInterval(updateSwissClock, 1000);
    updateSwissClock();
</script>