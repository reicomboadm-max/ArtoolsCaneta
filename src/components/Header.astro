---
// Header.astro
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = pathname === '/';
const isCatalogo = pathname.startsWith('/catalogo');
const isProduto = pathname.startsWith('/produtos') || pathname.startsWith('/produto');
---

<header id="main-header" transition:persist class="relative z-50 border-b border-stone-300 dark:border-stone-800 sticky top-0 bg-[#EAEAE5]/95 dark:bg-[#10100E]/95 backdrop-blur-md transition-all duration-300">
    <div class="flex justify-between items-center px-4 sm:px-6 md:px-10 py-3 md:py-3.5">
        
        <!-- Left: Logo Minimalista (Ícone + Nome) -->
        <a href="/" class="flex items-center gap-2 group cursor-pointer focus:outline-none focus:ring-1 focus:ring-stone-900 rounded-sm p-1 shrink-0" aria-label="ARTOOLS Pigmentum Início">
            <svg class="w-5 h-5 text-stone-900 dark:text-teal-400 group-hover:rotate-12 transition-transform duration-300 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 19l7-7 3 3-7 7-3-3z"></path>
                <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
                <path d="M2 2l7.586 7.586"></path>
                <circle cx="11" cy="11" r="2"></circle>
            </svg>
            <span class="font-extrabold tracking-tighter text-base sm:text-lg font-display text-stone-900 dark:text-white leading-none">
                ARTOOLS<span class="text-stone-700 dark:text-teal-400 font-normal">.PIGMENTUM</span>
            </span>
        </a>

        <!-- Center: Links Desktop Centrais com Destaque Dinâmico -->
        <nav class="hidden lg:flex items-center gap-6 xl:gap-8" aria-label="Navegação Principal" id="main-desktop-nav">
            <!-- 01. Início -->
            <a 
                href="/" 
                data-nav-path="/"
                class={`desktop-nav-link text-xs font-mono tracking-widest uppercase transition-colors flex items-center gap-1.5 focus:outline-none rounded-sm px-1.5 py-0.5 ${
                    isHome 
                    ? 'text-stone-950 dark:text-teal-400 font-bold' 
                    : 'text-stone-600 dark:text-stone-400 hover:text-stone-950 dark:hover:text-teal-400'
                }`}
            >
                <span class={`nav-dot w-1.5 h-1.5 rounded-full transition-colors ${
                    isHome 
                    ? 'bg-stone-900 dark:bg-teal-400 ring-2 ring-stone-900/20 dark:ring-teal-400/30' 
                    : 'bg-stone-400 dark:bg-stone-600'
                }`}></span>
                01. Início
            </a>

            <!-- 02. Catálogo -->
            <a 
                href="/catalogo" 
                data-nav-path="/catalogo"
                class={`desktop-nav-link text-xs font-mono tracking-widest uppercase transition-colors flex items-center gap-1.5 focus:outline-none rounded-sm px-1.5 py-0.5 ${
                    isCatalogo 
                    ? 'text-stone-950 dark:text-teal-400 font-bold' 
                    : 'text-stone-600 dark:text-stone-400 hover:text-stone-950 dark:hover:text-teal-400'
                }`}
            >
                <span class={`nav-dot w-1.5 h-1.5 rounded-full transition-colors ${
                    isCatalogo 
                    ? 'bg-stone-900 dark:bg-teal-400 ring-2 ring-stone-900/20 dark:ring-teal-400/30' 
                    : 'bg-stone-400 dark:bg-stone-600'
                }`}></span>
                02. Catálogo
            </a>

            <!-- 03. Detalhes -->
            <a 
                href="/produtos/0.1" 
                data-nav-path="/produtos"
                class={`desktop-nav-link text-xs font-mono tracking-widest uppercase transition-colors flex items-center gap-1.5 focus:outline-none rounded-sm px-1.5 py-0.5 ${
                    isProduto 
                    ? 'text-stone-950 dark:text-teal-400 font-bold' 
                    : 'text-stone-600 dark:text-stone-400 hover:text-stone-950 dark:hover:text-teal-400'
                }`}
            >
                <span class={`nav-dot w-1.5 h-1.5 rounded-full transition-colors ${
                    isProduto 
                    ? 'bg-stone-900 dark:bg-teal-400 ring-2 ring-stone-900/20 dark:ring-teal-400/30' 
                    : 'bg-stone-400 dark:bg-stone-600'
                }`}></span>
                03. Detalhes
            </a>
        </nav>

        <!-- Right: Botão de Menu Minimalista & Sutil + Alternador de Tema -->
        <div class="flex items-center gap-2 sm:gap-2.5">
            
            <!-- Alternador de Tema (Claro / Escuro) -->
            <button 
                id="theme-toggle" 
                class="w-8 h-8 rounded-md border border-stone-300 dark:border-stone-700 bg-white/70 dark:bg-stone-800/70 flex items-center justify-center text-stone-700 dark:text-stone-300 hover:text-stone-950 dark:hover:text-teal-300 hover:border-stone-900 transition-all shadow-xs focus:outline-none" 
                aria-label="Alternar tema claro e escuro" 
                title="Alternar Modo Claro / Escuro"
            >
                <iconify-icon id="theme-icon" icon="solar:sun-2-linear" class="text-sm"></iconify-icon>
            </button>

            <!-- BOTÃO DE MENU MINIMALISTA E SUTIL NO CANTO SUPERIOR DIREITO -->
            <button 
                id="nav-menu-btn"
                type="button"
                onclick="window.toggleNavDropdown(event)"
                class="px-3 py-1.5 rounded-md border border-stone-300 dark:border-stone-700 bg-white/70 dark:bg-stone-800/70 hover:bg-stone-900 hover:text-white hover:border-stone-900 dark:hover:bg-white dark:hover:text-stone-950 dark:hover:border-white text-stone-800 dark:text-stone-200 font-mono text-xs uppercase tracking-wider flex items-center gap-1.5 transition-all cursor-pointer select-none shadow-xs font-semibold"
                aria-label="Abrir Menu de Escolha"
                aria-expanded="false"
                aria-haspopup="true"
            >
                <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
                <span>Menu</span>
                <svg id="menu-arrow-icon" class="w-3 h-3 opacity-60 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </button>
        </div>
    </div>

    <!-- PAINEL DROPDOWN SUSPENSO DO MENU (Minimalista & Elegante) -->
    <div 
        id="nav-dropdown-menu" 
        class="hidden absolute right-4 sm:right-6 md:right-10 top-[calc(100%+6px)] w-72 sm:w-80 rounded-lg bg-white dark:bg-[#141412] border border-stone-300 dark:border-stone-700 shadow-2xl p-3.5 transition-all duration-200 z-50"
        role="menu"
        aria-orientation="vertical"
    >
        <div class="space-y-2.5 text-left">
            <div class="flex items-center justify-between border-b border-stone-200 dark:border-stone-800 pb-2 text-[10px] font-mono uppercase tracking-widest text-stone-500 dark:text-stone-400 font-bold">
                <span>Navegação</span>
                <span class="text-teal-600 dark:text-teal-400">ARTOOLS 2026</span>
            </div>

            <!-- Lista de Opções de Menu -->
            <div class="space-y-1" id="dropdown-menu-list">
                <!-- Opção 1: Início -->
                <a 
                    href="/" 
                    data-dropdown-path="/"
                    class={`dropdown-nav-item group block p-2.5 rounded-md transition-colors ${
                        isHome 
                        ? 'bg-stone-900 text-white dark:bg-white dark:text-stone-950 font-bold shadow-xs' 
                        : 'text-stone-800 dark:text-stone-200 hover:bg-stone-100 dark:hover:bg-stone-800/70'
                    }`}
                    role="menuitem"
                >
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-mono tracking-wider flex items-center gap-2">
                            <span class={`dropdown-dot w-1.5 h-1.5 rounded-full ${isHome ? 'bg-teal-400 dark:bg-teal-500' : 'bg-stone-400'}`}></span>
                            01. Início
                        </span>
                        <span class="text-[10px] font-mono opacity-70">Visão Geral →</span>
                    </div>
                </a>

                <!-- Opção 2: Catálogo -->
                <a 
                    href="/catalogo" 
                    data-dropdown-path="/catalogo"
                    class={`dropdown-nav-item group block p-2.5 rounded-md transition-colors ${
                        isCatalogo 
                        ? 'bg-stone-900 text-white dark:bg-white dark:text-stone-950 font-bold shadow-xs' 
                        : 'text-stone-800 dark:text-stone-200 hover:bg-stone-100 dark:hover:bg-stone-800/70'
                    }`}
                    role="menuitem"
                >
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-mono tracking-wider flex items-center gap-2">
                            <span class={`dropdown-dot w-1.5 h-1.5 rounded-full ${isCatalogo ? 'bg-teal-400 dark:bg-teal-500' : 'bg-stone-400'}`}></span>
                            02. Catálogo
                        </span>
                        <span class="text-[10px] font-mono opacity-70">09 Canetas →</span>
                    </div>
                </a>

                <!-- Opção 3: Detalhes -->
                <a 
                    href="/produtos/0.1" 
                    data-dropdown-path="/produtos"
                    class={`dropdown-nav-item group block p-2.5 rounded-md transition-colors ${
                        isProduto 
                        ? 'bg-stone-900 text-white dark:bg-white dark:text-stone-950 font-bold shadow-xs' 
                        : 'text-stone-800 dark:text-stone-200 hover:bg-stone-100 dark:hover:bg-stone-800/70'
                    }`}
                    role="menuitem"
                >
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-mono tracking-wider flex items-center gap-2">
                            <span class={`dropdown-dot w-1.5 h-1.5 rounded-full ${isProduto ? 'bg-teal-400 dark:bg-teal-500' : 'bg-stone-400'}`}></span>
                            03. Detalhes
                        </span>
                        <span class="text-[10px] font-mono opacity-70">Ficha Técnica →</span>
                    </div>
                </a>
            </div>
        </div>
    </div>
</header>

<script is:inline>
    // Função Global de Abertura / Fechamento do Menu no Topo Direito
    window.toggleNavDropdown = function(e) {
        if (e) e.stopPropagation();
        const menu = document.getElementById('nav-dropdown-menu');
        const btn = document.getElementById('nav-menu-btn');
        const arrow = document.getElementById('menu-arrow-icon');
        
        if (!menu) return;

        const isHidden = menu.classList.contains('hidden');
        if (isHidden) {
            menu.classList.remove('hidden');
            if (btn) btn.setAttribute('aria-expanded', 'true');
            if (arrow) arrow.style.transform = 'rotate(180deg)';
        } else {
            menu.classList.add('hidden');
            if (btn) btn.setAttribute('aria-expanded', 'false');
            if (arrow) arrow.style.transform = 'rotate(0deg)';
        }
    };

    window.closeNavDropdown = function() {
        const menu = document.getElementById('nav-dropdown-menu');
        const btn = document.getElementById('nav-menu-btn');
        const arrow = document.getElementById('menu-arrow-icon');
        
        if (menu) menu.classList.add('hidden');
        if (btn) btn.setAttribute('aria-expanded', 'false');
        if (arrow) arrow.style.transform = 'rotate(0deg)';
    };

    // Atualiza com precisão todos os marcadores visuais da página ativa
    function syncActivePageIndicators() {
        const rawPath = window.location.pathname.replace(/\/$/, '') || '/';
        const isHome = rawPath === '/' || rawPath === '/index.html';
        const isCatalogo = rawPath.startsWith('/catalogo') || rawPath.startsWith('/pagina2');
        const isProduto = rawPath.startsWith('/produtos') || rawPath.startsWith('/produto');

        // 1. Sincroniza os links do Menu Desktop Central
        document.querySelectorAll('#main-desktop-nav .desktop-nav-link').forEach(link => {
            const targetPath = link.getAttribute('data-nav-path');
            const dot = link.querySelector('.nav-dot');
            const isActive = (targetPath === '/' && isHome) || (targetPath === '/catalogo' && isCatalogo) || (targetPath === '/produtos' && isProduto);

            if (isActive) {
                link.className = 'desktop-nav-link text-xs font-mono tracking-widest uppercase transition-colors flex items-center gap-1.5 focus:outline-none rounded-sm px-1.5 py-0.5 text-stone-950 dark:text-teal-400 font-bold';
                if (dot) {
                    dot.className = 'nav-dot w-1.5 h-1.5 rounded-full transition-colors bg-stone-900 dark:bg-teal-400 ring-2 ring-stone-900/20 dark:ring-teal-400/30';
                }
            } else {
                link.className = 'desktop-nav-link text-xs font-mono tracking-widest uppercase transition-colors flex items-center gap-1.5 focus:outline-none rounded-sm px-1.5 py-0.5 text-stone-600 dark:text-stone-400 hover:text-stone-950 dark:hover:text-teal-400';
                if (dot) {
                    dot.className = 'nav-dot w-1.5 h-1.5 rounded-full transition-colors bg-stone-400 dark:bg-stone-600';
                }
            }
        });

        // 2. Sincroniza os links dentro do Dropdown Menu
        document.querySelectorAll('#dropdown-menu-list .dropdown-nav-item').forEach(link => {
            const targetPath = link.getAttribute('data-dropdown-path');
            const dot = link.querySelector('.dropdown-dot');
            const isActive = (targetPath === '/' && isHome) || (targetPath === '/catalogo' && isCatalogo) || (targetPath === '/produtos' && isProduto);

            if (isActive) {
                link.className = 'dropdown-nav-item group block p-2.5 rounded-md transition-colors bg-stone-900 text-white dark:bg-white dark:text-stone-950 font-bold shadow-xs';
                if (dot) {
                    dot.className = 'dropdown-dot w-1.5 h-1.5 rounded-full bg-teal-400 dark:bg-teal-500';
                }
            } else {
                link.className = 'dropdown-nav-item group block p-2.5 rounded-md transition-colors text-stone-800 dark:text-stone-200 hover:bg-stone-100 dark:hover:bg-stone-800/70';
                if (dot) {
                    dot.className = 'dropdown-dot w-1.5 h-1.5 rounded-full bg-stone-400';
                }
            }
        });

        window.closeNavDropdown();
    }

    // Executa em todos os ciclos de vida do Astro ClientRouter e navegação nativa
    syncActivePageIndicators();
    document.addEventListener('DOMContentLoaded', syncActivePageIndicators);
    document.addEventListener('astro:page-load', syncActivePageIndicators);
    document.addEventListener('astro:after-swap', syncActivePageIndicators);
    window.addEventListener('popstate', syncActivePageIndicators);

    // Fechar ao clicar fora
    document.addEventListener('click', (e) => {
        const menu = document.getElementById('nav-dropdown-menu');
        const btn = document.getElementById('nav-menu-btn');
        if (menu && !menu.contains(e.target) && btn && !btn.contains(e.target)) {
            window.closeNavDropdown();
        }
    });

    // Fechar com ESC
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') window.closeNavDropdown();
    });
</script>
