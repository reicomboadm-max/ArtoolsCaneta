---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  image?: string;
}

const {
  title = 'ArtTools — Canetas técnicas para quem desenha a sério',
  description = 'Precisão, acabamento premium e traço constante.',
  canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://artools-caneta.vercel.app').href,
  image = '/og-image.jpg',
} = Astro.props;

// Converte a imagem e URL em caminhos absolutos usando Astro.site ou fallback da aplicação
const siteUrl = Astro.site || 'https://artools-caneta.vercel.app';
const absoluteImageUrl = new URL(image, siteUrl).href;
const currentUrl = canonicalURL || new URL(Astro.url.pathname, siteUrl).href;
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
<head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-TP4Z6SB3');</script>
    <!-- End Google Tag Manager -->

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-EP3ZT71CG3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-EP3ZT71CG3');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={currentUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={currentUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImageUrl} />

    <ClientRouter />

    <!-- Preconnect & DNS-Prefetch for Critical CDNs -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://api.iconify.design" crossorigin />
    <link rel="dns-prefetch" href="https://api.iconify.design" />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital@1&family=Inter:wght@200;300;400;500;600;700;800;900&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital@1&family=Inter:wght@200;300;400;500;600;700;800;900&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital@1&family=Inter:wght@200;300;400;500;600;700;800;900&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" />
    </noscript>

    <!-- Iconify & Lucide Icons (Deferred for non-blocking rendering) -->
    <script is:inline defer src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
</head>
<body class="bg-[#EAEAE5] dark:bg-[#10100E] text-stone-900 dark:text-stone-100 min-h-screen flex flex-col font-sans transition-colors duration-300">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TP4Z6SB3"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Header transition:persist />
    <div class="flex-grow">
        <slot />
    </div>
    <Footer />

    <script is:inline>
        // Theme toggle logic compatível com ClientRouter
        function setupTheme() {
            const themeToggle = document.getElementById('theme-toggle');
            const themeIcon = document.getElementById('theme-icon');
            
            // Check saved theme or system preference
            if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
                if (themeIcon) themeIcon.setAttribute('icon', 'solar:moon-linear');
            } else {
                document.documentElement.classList.remove('dark');
                if (themeIcon) themeIcon.setAttribute('icon', 'solar:sun-2-linear');
            }

            if (themeToggle && !themeToggle._hasThemeListener) {
                themeToggle._hasThemeListener = true;
                themeToggle.addEventListener('click', () => {
                    if (document.documentElement.classList.contains('dark')) {
                        document.documentElement.classList.remove('dark');
                        localStorage.theme = 'light';
                        if (themeIcon) themeIcon.setAttribute('icon', 'solar:sun-2-linear');
                    } else {
                        document.documentElement.classList.add('dark');
                        localStorage.theme = 'dark';
                        if (themeIcon) themeIcon.setAttribute('icon', 'solar:moon-linear');
                    }
                });
            }
        }

        function silenceAllMedia() {
            document.querySelectorAll('video, audio').forEach(el => {
                el.muted = true;
                el.defaultMuted = true;
                el.volume = 0;
            });
        }

        setupTheme();
        silenceAllMedia();
        document.addEventListener('DOMContentLoaded', () => {
            setupTheme();
            silenceAllMedia();
        });
        document.addEventListener('astro:page-load', () => {
            setupTheme();
            silenceAllMedia();
        });
        document.addEventListener('astro:after-swap', silenceAllMedia);
    </script>
</body>
</html>
