---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
	description?: string;
}

const { title = "ARTOOLS Pigmentum", description = "Instrumentos de desenho técnico com calibração suíça." } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <ClientRouter />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital@1&family=Inter:wght@200;300;400;500;600;700;800;900&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Tailwind Play CDN -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
                        mono: ['JetBrains Mono', 'Space Mono', 'monospace'],
                        display: ['Space Grotesk', 'Inter', 'sans-serif'],
                    },
                    colors: {
                        canvas: '#EAEAE5',
                        sand: {
                            50: '#FDFDFC',
                            100: '#F7F7F4',
                            200: '#EAEAE5',
                            300: '#DDDDD7',
                            400: '#C2C2B8',
                            500: '#9E9E94',
                            800: '#2C2C29',
                            900: '#1C1C1A',
                        },
                        stone: {
                            50: '#fafaf9',
                            100: '#f5f5f4',
                            200: '#e7e5e4',
                            300: '#d6d3d1',
                            400: '#a8a29e',
                            500: '#78716c',
                            600: '#57534e',
                            700: '#44403c',
                            800: '#292524',
                            900: '#1c1917',
                            950: '#0c0a09',
                        },
                        accent: {
                            coral: '#FF6347',
                            coralHover: '#FF4500',
                            teal: '#14B8A6',
                            emerald: '#10B981',
                            cyan: '#06B6D4',
                            acid: '#CCFF00',
                            amber: '#F59E0B',
                            rose: '#F43F5E'
                        }
                    }
                }
            }
        };
    </script>

    <!-- Iconify & Lucide Icons -->
    <script is:inline src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
</head>
<body class="bg-[#EAEAE5] dark:bg-[#10100E] text-stone-900 dark:text-stone-100 min-h-screen flex flex-col font-sans transition-colors duration-300">
    <Header transition:persist />
    <div class="flex-grow">
        <slot />
    </div>
    <Footer />

    <script is:inline>
        // Theme toggle logic compatível com ClientRouter
        function setupTheme() {
            const themeToggle = document.getElementById('theme-toggle');
            const themeIcon = document.getElementById('theme-icon');
            
            // Check saved theme or system preference
            if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
                if (themeIcon) themeIcon.setAttribute('icon', 'solar:moon-linear');
            } else {
                document.documentElement.classList.remove('dark');
                if (themeIcon) themeIcon.setAttribute('icon', 'solar:sun-2-linear');
            }

            if (themeToggle && !themeToggle._hasThemeListener) {
                themeToggle._hasThemeListener = true;
                themeToggle.addEventListener('click', () => {
                    if (document.documentElement.classList.contains('dark')) {
                        document.documentElement.classList.remove('dark');
                        localStorage.theme = 'light';
                        if (themeIcon) themeIcon.setAttribute('icon', 'solar:sun-2-linear');
                    } else {
                        document.documentElement.classList.add('dark');
                        localStorage.theme = 'dark';
                        if (themeIcon) themeIcon.setAttribute('icon', 'solar:moon-linear');
                    }
                });
            }
        }

        function silenceAllMedia() {
            document.querySelectorAll('video, audio').forEach(el => {
                el.muted = true;
                el.defaultMuted = true;
                el.volume = 0;
            });
        }

        setupTheme();
        silenceAllMedia();
        document.addEventListener('DOMContentLoaded', () => {
            setupTheme();
            silenceAllMedia();
        });
        document.addEventListener('astro:page-load', () => {
            setupTheme();
            silenceAllMedia();
        });
        document.addEventListener('astro:after-swap', silenceAllMedia);
    </script>
</body>
</html>
