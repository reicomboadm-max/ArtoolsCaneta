---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { Image } from 'astro:assets';

// Importação das imagens otimizadas de src/assets/
import canetaImg from '../assets/caneta.png';
import penIsolatedImg from '../assets/pen_isolated.png';
import penRenderImg from '../assets/pen_render.png';
import penPhotoImg from '../assets/pen_photo.jpeg';

// Lista minimalista com as 9 canetas técnicas ARTOOLS Pigmentum
const pens = [
  {
    id: '0.05',
    title: 'ARTOOLS Pigmentum 0.05',
    tag: '0.05mm',
    badge: 'Ultra-Micro',
    image: canetaImg,
    strokePreview: 'h-[1px] w-12 bg-stone-900 dark:bg-white',
    shortDesc: 'Microponta cirúrgica calibrada para hachuras e nanodetalhes técnicos.',
    price: 'R$ 38,90',
  },
  {
    id: '0.1',
    title: 'ARTOOLS Pigmentum 0.1',
    tag: '0.10mm',
    badge: 'Mais Vendida',
    image: penIsolatedImg,
    strokePreview: 'h-[1.5px] w-12 bg-stone-900 dark:bg-white',
    shortDesc: 'O padrão internacional para plantas baixas, cotas e linework arquitetônico.',
    price: 'R$ 38,90',
  },
  {
    id: '0.2',
    title: 'ARTOOLS Pigmentum 0.2',
    tag: '0.20mm',
    badge: 'Precisão',
    image: penRenderImg,
    strokePreview: 'h-[2px] w-12 bg-stone-900 dark:bg-white',
    shortDesc: 'Linha guia e estruturação técnica com fluxo estequiométrico contínuo.',
    price: 'R$ 38,90',
  },
  {
    id: '0.3',
    title: 'ARTOOLS Pigmentum 0.3',
    tag: '0.30mm',
    badge: 'Equilíbrio',
    image: canetaImg,
    strokePreview: 'h-[2.5px] w-12 bg-stone-900 dark:bg-white',
    shortDesc: 'Ideal para rendering de design, ilustração vetorial e documentação.',
    price: 'R$ 38,90',
  },
  {
    id: '0.5',
    title: 'ARTOOLS Pigmentum 0.5',
    tag: '0.50mm',
    badge: 'Linha Mestra',
    image: penIsolatedImg,
    strokePreview: 'h-[3px] w-12 bg-stone-900 dark:bg-white',
    shortDesc: 'Traço marcante para contornos primários e hierarquias visuais fortes.',
    price: 'R$ 38,90',
  },
  {
    id: '0.8',
    title: 'ARTOOLS Pigmentum 0.8',
    tag: '0.80mm',
    badge: 'Alto Contraste',
    image: penRenderImg,
    strokePreview: 'h-[4px] w-12 bg-stone-900 dark:bg-white',
    shortDesc: 'Preto profundo 2.4 DMAX para silhuetas dramáticas e cortes pesados.',
    price: 'R$ 42,90',
  },
  {
    id: '1.0',
    title: 'ARTOOLS Pigmentum 1.0',
    tag: '1.00mm',
    badge: 'Seção Pesada',
    image: canetaImg,
    strokePreview: 'h-[5px] w-12 bg-stone-900 dark:bg-white',
    shortDesc: 'Espessura máxima linear para pranchas e composições de grande formato.',
    price: 'R$ 42,90',
  },
  {
    id: 'br',
    title: 'ARTOOLS Pigmentum Brush',
    tag: 'BR (0.2-3.5mm)',
    badge: 'Ponta Pincel',
    image: penPhotoImg,
    strokePreview: 'h-[5px] w-12 bg-gradient-to-r from-stone-900 to-transparent dark:from-white rounded-none',
    shortDesc: 'Cerdas sintéticas japonesas com memória para modulação dinâmica do traço.',
    price: 'R$ 49,90',
  },
  {
    id: 'ch',
    title: 'ARTOOLS Pigmentum Chisel',
    tag: 'CH (2.0mm)',
    badge: 'Chanfrada',
    image: penRenderImg,
    strokePreview: 'h-[4px] w-12 bg-stone-900 dark:bg-white transform skew-x-12',
    shortDesc: 'Ponta chanfrada rígida para caligrafia arquitetônica e lettering técnico.',
    price: 'R$ 49,90',
  }
];
---

<Layout 
    title="Coleção Completa ARTOOLS Pigmentum — Todas as Pontas Técnicas" 
    description="Explore a coleção completa de canetas técnicas ARTOOLS Pigmentum. Graduações de 0.05mm a 1.0mm, Brush e Chanfrada com tinta japonesa à prova d'água e precisão cirúrgica."
    image="/images/og-pagina2.png"
>
    
    <!-- Header Minimalista com Padrão Arquitetônico Thiago Design System -->
    <section class="pt-14 pb-10 px-6 sm:px-12 md:px-16 max-w-7xl mx-auto border-b border-stone-300 dark:border-stone-800">
        <div class="space-y-3 text-left">
            <span class="text-xs font-mono uppercase tracking-widest text-[#78716C] dark:text-stone-400 font-bold block">
                02 // CATÁLOGO DE INSTRUMENTOS TÉCNICOS
            </span>

            <h1 class="text-3xl sm:text-5xl font-bold font-display tracking-tight text-[#1C1917] dark:text-white leading-tight">
                Artools <span class="font-normal font-display">Pigmentum™</span>
            </h1>

            <p class="text-[#57534E] dark:text-stone-400 text-sm max-w-xl leading-relaxed font-sans">
                Micromecânica suíça de precisão, calibração capilar de ±0.002mm e fórmula arquivística 100% resistente à água e UV.
            </p>
        </div>
    </section>

    <!-- Grid Minimalista com Componente <Image /> do Astro -->
    <section class="py-12 sm:py-16 px-6 sm:px-12 md:px-16 max-w-7xl mx-auto">
        <h2 class="sr-only">Graduações e Modelos Técnicos Disponíveis</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {pens.map((pen, index) => (
                <article 
                    class="group relative rounded-lg bg-white dark:bg-[#141412] border border-stone-300 dark:border-stone-800 hover:border-stone-900 dark:hover:border-teal-400 flex flex-col justify-between overflow-hidden transition-all duration-300 shadow-sm"
                    id={`card-${pen.id}`}
                >
                    <!-- Imagem Ocupando Toda a Parte Superior -->
                    <div class="relative w-full h-64 bg-[#F4F4F0] dark:bg-[#191917] border-b border-stone-200 dark:border-stone-800 flex flex-col justify-between p-4 overflow-hidden">
                        
                        <!-- Telemetria do Topo -->
                        <div class="flex items-center justify-between z-10">
                            <span class="text-[11px] font-mono font-bold text-stone-400 dark:text-stone-500">
                                0{index + 1} // {pen.tag}
                            </span>
                            <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded-sm bg-white dark:bg-black text-stone-800 dark:text-stone-200 border border-stone-300 dark:border-stone-700 font-semibold">
                                {pen.badge}
                            </span>
                        </div>

                        <!-- Área da Imagem Otimizada com <Image /> -->
                        <a href={`/produto?calibre=${pen.id}`} class="flex-1 my-1 w-full flex items-center justify-center cursor-pointer p-2 overflow-hidden">
                            <Image 
                                src={pen.image} 
                                alt={pen.title}
                                class="max-h-36 sm:max-h-40 max-w-full w-auto object-contain filter drop-shadow group-hover:scale-105 transition-transform duration-300"
                                loading={index < 3 ? "eager" : "lazy"}
                                fetchpriority={index < 3 ? "high" : "auto"}
                            />
                        </a>

                        <!-- Amostra de Traço Inferior -->
                        <div class="flex items-center justify-between text-[11px] font-mono text-stone-600 dark:text-stone-400 z-10 pt-1 border-t border-stone-200/50 dark:border-stone-800/50">
                            <span class="text-[9px] uppercase tracking-wider">TRAÇO REAL</span>
                            <div class={pen.strokePreview}></div>
                        </div>
                    </div>

                    <!-- Conteúdo Minimalista -->
                    <div class="p-5 flex flex-col justify-between flex-grow space-y-4">
                        <div class="space-y-1.5 text-left">
                            <div class="flex items-baseline justify-between gap-2">
                                <h3 class="text-base font-bold font-display text-[#1C1917] dark:text-white tracking-tight">
                                    <a href={`/produto?calibre=${pen.id}`} class="hover:text-teal-600 dark:hover:text-teal-400 transition-colors">
                                        {pen.title}
                                    </a>
                                </h3>
                                <span class="text-xs font-mono font-bold text-[#1C1917] dark:text-white shrink-0">
                                    {pen.price}
                                </span>
                            </div>
                            
                            <p class="text-xs text-[#78716C] dark:text-stone-400 leading-relaxed font-sans line-clamp-2">
                                {pen.shortDesc}
                            </p>
                        </div>

                        <!-- Botão com Link Direto para a Página 3 (Detalhes do Produto) -->
                        <div class="pt-2">
                            <Button 
                                href={`/produto?calibre=${pen.id}`}
                                variant="primary"
                                shape="square"
                                size="sm"
                                class="w-full justify-center gap-2 font-mono text-xs uppercase tracking-wider"
                            >
                                <iconify-icon icon="solar:document-text-linear" class="text-sm"></iconify-icon>
                                Aviso & Especificações
                            </Button>
                        </div>
                    </div>

                </article>
            ))}
        </div>
    </section>

</Layout>
