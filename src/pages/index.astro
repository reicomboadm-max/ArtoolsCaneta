    <!-- ============================================================
         APPLE-GRADE DUAL-BUFFER CANVAS SCROLL ENGINE (60-120 FPS)
    ============================================================ -->
    <script is:inline data-astro-rerun>
        let indexLenis = null;
        let indexRafId = null;

        function cleanupIndexPage() {
            if (indexRafId) {
                cancelAnimationFrame(indexRafId);
                indexRafId = null;
            }
            if (window.ScrollTrigger) {
                ScrollTrigger.getAll().forEach(t => t.kill());
            }
            if (indexLenis) {
                try { indexLenis.destroy(); } catch (e) {}
                indexLenis = null;
            }
        }

        function initIndexPage() {
            // Garante silêncio absoluto em todos os elementos de mídia
            document.querySelectorAll('video, audio').forEach(el => {
                el.muted = true;
                el.defaultMuted = true;
                el.volume = 0;
            });

            cleanupIndexPage();

            // Register GSAP Plugin
            if (window.gsap && window.ScrollTrigger) {
                gsap.registerPlugin(ScrollTrigger);
            }

            // 1. Lenis Smooth Scroll Setup with GSAP Synchronization
            try {
                if (window.Lenis) {
                    indexLenis = new Lenis({
                        duration: 1.1,
                        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
                        direction: 'vertical',
                        gestureDirection: 'vertical',
                        smooth: true,
                        smoothTouch: false,
                        touchMultiplier: 1.8,
                    });

                    indexLenis.on('scroll', ScrollTrigger.update);

                    gsap.ticker.add((time) => {
                        if (indexLenis) indexLenis.raf(time * 1000);
                    });

                    gsap.ticker.lagSmoothing(0);
                }
            } catch (err) {
                console.warn('Lenis scroll running in standard mode:', err);
            }

            // -------------------------------------------------------------
            // Canvas & Video Elements for Hero 3D Spatial Canvas (100% Muted)
            // -------------------------------------------------------------
            const canvas = document.getElementById('pen-canvas');
            const video = document.getElementById('pen-video-source');
            const telemetryPercentage = document.getElementById('telemetry-percentage');
            const coralProgressLine = document.getElementById('coral-progress-line');
            const verticalScrollTick = document.getElementById('vertical-scroll-tick');

            const hotspotTip = document.getElementById('hotspot-tip');
            const hotspotInk = document.getElementById('hotspot-ink');
            const hotspotClip = document.getElementById('hotspot-clip');
            const heroLeftContent = document.getElementById('hero-left-content');

            if (!canvas || !video) return;

            // Strict Audio Muting
            video.muted = true;
            video.defaultMuted = true;
            video.volume = 0;
            video.pause();

            const ctx = canvas.getContext('2d', { alpha: true, desynchronized: true });
            let canvasWidth = 0;
            let canvasHeight = 0;
            let videoAspect = 16 / 9;

            const VIDEO_START_OFFSET = 1.0; 
            let videoDuration = 3.5;
            let targetProgress = 0;
            let currentProgress = 0;
            let isSeeking = false;
            let pendingSeekTime = null;
            let lastDrawnTime = -1;

            // Fallback Image instant preload
            const fallbackSrc = canvas.getAttribute('data-fallback-src');
            let fallbackImage = null;
            if (fallbackSrc) {
                fallbackImage = new Image();
                fallbackImage.src = fallbackSrc;
                fallbackImage.onload = () => {
                    if (video.readyState < 2) {
                        renderFrameToCanvas(fallbackImage);
                    }
                };
            }

            // Resize Canvas with HiDPI support
            function resizeCanvas() {
                if (!canvas) return;
                const rect = canvas.getBoundingClientRect();
                const dpr = Math.min(window.devicePixelRatio || 1, 2);
                canvasWidth = canvas.width = rect.width * dpr;
                canvasHeight = canvas.height = rect.height * dpr;
                if (video.readyState >= 2) {
                    renderFrameToCanvas(video);
                } else if (fallbackImage && fallbackImage.complete) {
                    renderFrameToCanvas(fallbackImage);
                }
            }
            window.addEventListener('resize', resizeCanvas);
            resizeCanvas();

            // Draw a frame centered
            function renderFrameToCanvas(source) {
                if (!source || !ctx || canvasWidth === 0) return;

                const srcWidth = source.videoWidth || source.naturalWidth || source.width || 1920;
                const srcHeight = source.videoHeight || source.naturalHeight || source.height || 1080;
                if (srcWidth === 0 || srcHeight === 0) return;

                ctx.clearRect(0, 0, canvasWidth, canvasHeight);
                videoAspect = srcWidth / srcHeight;

                const canvasAspect = canvasWidth / canvasHeight;
                let drawWidth, drawHeight, offsetX, offsetY;

                if (canvasAspect > videoAspect) {
                    drawHeight = canvasHeight;
                    drawWidth = canvasHeight * videoAspect;
                    offsetX = (canvasWidth - drawWidth) / 2;
                    offsetY = 0;
                } else {
                    drawWidth = canvasWidth;
                    drawHeight = canvasWidth / videoAspect;
                    offsetX = 0;
                    offsetY = (canvasHeight - drawHeight) / 2;
                }

                ctx.drawImage(source, offsetX, offsetY, drawWidth, drawHeight);
            }

            // Non-blocking seek queue for video decoder
            function safeSeekVideo(time) {
                if (isSeeking) {
                    pendingSeekTime = time;
                    return;
                }
                isSeeking = true;
                if ('fastSeek' in video) {
                    video.fastSeek(time);
                } else {
                    video.currentTime = time;
                }
            }

            video.addEventListener('seeked', () => {
                isSeeking = false;
                renderFrameToCanvas(video);
                if (pendingSeekTime !== null) {
                    const nextTime = pendingSeekTime;
                    pendingSeekTime = null;
                    safeSeekVideo(nextTime);
                }
            });

            // Setup GSAP ScrollTrigger for Hero
            function initEngine() {
                video.muted = true;
                video.volume = 0;
                video.pause();
                
                videoDuration = video.duration || 3.5;
                resizeCanvas();
                safeSeekVideo(VIDEO_START_OFFSET);

                if (!window.ScrollTrigger) return;

                ScrollTrigger.create({
                    trigger: '#scroll-hero-section',
                    start: 'top top',
                    end: 'bottom bottom',
                    scrub: 0.15,
                    onUpdate: (self) => {
                        targetProgress = self.progress;

                        // Telemetry HUD Update
                        const percentInt = Math.round(targetProgress * 100);
                        if (telemetryPercentage) telemetryPercentage.innerText = `${percentInt.toString().padStart(3, '0')}%`;
                        if (coralProgressLine) coralProgressLine.style.width = `${percentInt}%`;
                        if (verticalScrollTick) verticalScrollTick.style.top = `${percentInt * 0.92}%`;

                        // Headline Fade / Shift transformation as user scrolls
                        if (heroLeftContent) {
                            if (targetProgress < 0.28) {
                                const opacity = Math.max(0, 1 - (targetProgress / 0.22));
                                const translateY = -(targetProgress * 120);
                                heroLeftContent.style.opacity = opacity;
                                heroLeftContent.style.transform = `translateY(${translateY}px)`;
                                heroLeftContent.style.pointerEvents = opacity > 0.1 ? 'auto' : 'none';
                            } else {
                                heroLeftContent.style.opacity = '0';
                                heroLeftContent.style.transform = 'translateY(-120px)';
                                heroLeftContent.style.pointerEvents = 'none';
                            }
                        }

                        // Hotspot triggers
                        if (hotspotTip) {
                            if (targetProgress >= 0.18 && targetProgress <= 0.42) {
                                hotspotTip.classList.add('visible');
                            } else {
                                hotspotTip.classList.remove('visible');
                            }
                        }
                        if (hotspotInk) {
                            if (targetProgress >= 0.45 && targetProgress <= 0.72) {
                                hotspotInk.classList.add('visible');
                            } else {
                                hotspotInk.classList.remove('visible');
                            }
                        }
                        if (hotspotClip) {
                            if (targetProgress >= 0.75 && targetProgress <= 0.98) {
                                hotspotClip.classList.add('visible');
                            } else {
                                hotspotClip.classList.remove('visible');
                            }
                        }
                    }
                });
            }

            // Pré-carrega o vídeo em Blob URL para navegação ultra-fluida em 60-120fps sem gargalo de rede
            if (!video._hasBlobSource) {
                video._hasBlobSource = true;
                fetch('./assets/video/video2.mp4')
                    .then(res => {
                        if (res.ok) return res.blob();
                        throw new Error('Fallback direct');
                    })
                    .then(blob => {
                        video.src = URL.createObjectURL(blob);
                        video.muted = true;
                        video.volume = 0;
                        video.pause();
                        initEngine();
                    })
                    .catch(() => {
                        if (video.readyState >= 1) {
                            initEngine();
                        } else {
                            video.addEventListener('loadedmetadata', initEngine, { once: true });
                            video.load();
                        }
                    });
            } else {
                if (video.readyState >= 1) {
                    initEngine();
                } else {
                    video.addEventListener('loadedmetadata', initEngine, { once: true });
                    video.load();
                }
            }

            // 60-120 FPS Native RAF Render Loop with Damped Subpixel Lerp
            let isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            function renderLoop() {
                if (!isReducedMotion) {
                    currentProgress += (targetProgress - currentProgress) * 0.25;

                    if (videoDuration > 0) {
                        const startTime = Math.min(VIDEO_START_OFFSET, Math.max(0, videoDuration - 1.0));
                        const effectiveRange = Math.max(0.5, videoDuration - startTime);
                        const targetTime = startTime + (currentProgress * effectiveRange);
                        if (Math.abs(targetTime - lastDrawnTime) > 0.02) {
                            lastDrawnTime = targetTime;
                            safeSeekVideo(targetTime);
                        }
                    }
                } else {
                    currentProgress = targetProgress;
                    if (videoDuration > 0) {
                        const targetTime = VIDEO_START_OFFSET + (currentProgress * Math.max(0.5, videoDuration - VIDEO_START_OFFSET));
                        safeSeekVideo(targetTime);
                    }
                }

                indexRafId = requestAnimationFrame(renderLoop);
            }
            indexRafId = requestAnimationFrame(renderLoop);


            // -------------------------------------------------------------
            // 3. Second Fold Luxury Interactive Handlers & Media Switcher (Strictly Muted)
            // -------------------------------------------------------------
            const photoContainer = document.getElementById('media-photo-container');
            const videoContainer = document.getElementById('media-video-container');
            const btnShowPhoto = document.getElementById('btn-show-photo');
            const btnShowVideo = document.getElementById('btn-show-video');
            const secondaryVideo = document.getElementById('secondary-video');
            const glowVideo = document.getElementById('glow-bg-video');
            const luxuryStageCard = document.getElementById('luxury-stage-card');

            window.switchMediaMode = function(mode) {
                if (mode === 'video') {
                    if (photoContainer) {
                        photoContainer.classList.remove('opacity-100', 'scale-100');
                        photoContainer.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
                    }
                    if (videoContainer) {
                        videoContainer.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
                        videoContainer.classList.add('opacity-100', 'scale-100');
                    }
                    if (btnShowVideo) {
                        btnShowVideo.className = "px-3 py-1 rounded-full text-[10px] font-mono uppercase tracking-wider font-bold transition-all bg-[#1C1917] text-white shadow-sm";
                    }
                    if (btnShowPhoto) {
                        btnShowPhoto.className = "px-3 py-1 rounded-full text-[10px] font-mono uppercase tracking-wider text-stone-600 dark:text-stone-400 hover:text-stone-900 transition-all";
                    }
                    if (secondaryVideo) {
                        secondaryVideo.play().catch(() => {});
                    }
                } else {
                    if (videoContainer) {
                        videoContainer.classList.remove('opacity-100', 'scale-100');
                        videoContainer.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
                    }
                    if (photoContainer) {
                        photoContainer.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
                        photoContainer.classList.add('opacity-100', 'scale-100');
                    }
                    if (btnShowPhoto) {
                        btnShowPhoto.className = "px-3 py-1 rounded-full text-[10px] font-mono uppercase tracking-wider font-bold transition-all bg-[#1C1917] text-white shadow-sm";
                    }
                    if (btnShowVideo) {
                        btnShowVideo.className = "px-3 py-1 rounded-full text-[10px] font-mono uppercase tracking-wider text-stone-600 dark:text-stone-400 hover:text-stone-900 transition-all";
                    }
                }
            };

            // 3D Tilt Microinteraction on Luxury Stage Card
            if (luxuryStageCard) {
                luxuryStageCard.addEventListener('mousemove', (e) => {
                    const rect = luxuryStageCard.getBoundingClientRect();
                    const x = e.clientX - rect.left - rect.width / 2;
                    const y = e.clientY - rect.top - rect.height / 2;
                    const rotateX = -(y / rect.height) * 10;
                    const rotateY = (x / rect.width) * 10;
                    luxuryStageCard.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
                });

                luxuryStageCard.addEventListener('mouseleave', () => {
                    luxuryStageCard.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg)';
                });
            }

            // Automatic Playback Observers for video3 and background glow video
            const videoObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    const videoEl = entry.target.tagName === 'VIDEO' ? entry.target : entry.target.querySelector('video');
                    if (videoEl) {
                        videoEl.muted = true;
                        videoEl.volume = 0;
                        if (entry.isIntersecting) {
                            videoEl.play().catch(() => {});
                        } else {
                            videoEl.pause();
                        }
                    }
                });
            }, { threshold: 0.1 });

            if (luxuryStageCard) videoObserver.observe(luxuryStageCard);
            if (secondaryVideo) videoObserver.observe(secondaryVideo);
            if (glowVideo) videoObserver.observe(glowVideo);

            // Helper: Scroll to Video Section
            window.scrollToVideoSection = function() {
                const target = document.getElementById('video-showcase-section');
                if (target) {
                    if (indexLenis) {
                        indexLenis.scrollTo(target, { offset: 0, duration: 1.4 });
                    } else {
                        target.scrollIntoView({ behavior: 'smooth' });
                    }
                }
            };

            // -------------------------------------------------------------
            // 3.5 Third Fold Interactive Anatomy Deconstruction Layers
            // -------------------------------------------------------------
            const anatomyLayersData = [
                {
                    code: "LAYER // 01.TUNGSTEN_TIP",
                    icon: "solar:tuning-square-2-bold-duotone",
                    metric: "±0.002 mm",
                    title: "Micro-Esfera de Tungstênio 0.1mm",
                    desc: "Micro-esfera em liga de carbeto de tungstênio calibrada com tolerância suíça para distribuição molecular de tinta sem atrito mecânico.",
                    stat1: "0.100 mm",
                    stat2: "9.2 Mohs",
                    stat3: "Constante 60 FPS"
                },
                {
                    code: "LAYER // 02.INOX_GUIDE_TUBE",
                    icon: "solar:ruler-angular-bold-duotone",
                    metric: "5.2 mm",
                    title: "Guia Tubular de Aço Inox 316L",
                    desc: "Cilindro metálico estendido usinado em CNC de 5 eixos. Protege o traço contra desvios angulares em réguas e esquadros técnicos.",
                    stat1: "Aço Inox 316L",
                    stat2: "Anti-Borrão",
                    stat3: "Grau Cirúrgico"
                },
                {
                    code: "LAYER // 03.HYDROSTATIC_VACUUM",
                    icon: "solar:shield-check-bold-duotone",
                    metric: "1.0 atm",
                    title: "Regulador Capilar a Vácuo",
                    desc: "Sistema hidrostático anti-vazamento com labirinto microporoso. Equaliza a pressão interna contra variações de altitude e temperatura.",
                    stat1: "Vácuo Ativo",
                    stat2: "Anti-Leak 100%",
                    stat3: "Aviação Ready"
                },
                {
                    code: "LAYER // 04.CARBON_BLACK_INK",
                    icon: "solar:waterdrops-bold-duotone",
                    metric: "2.4 Dmax",
                    title: "Pigmentum™ Carbon Black Arquivístico",
                    desc: "Nanocristais de carbono puro em suspensão coloidal. Secagem imediata em 0.4s, à prova d'água, solventes alcoólicos e radiação UV.",
                    stat1: "Deep Black",
                    stat2: "100 Anos UV",
                    stat3: "0.4s Secagem"
                },
                {
                    code: "LAYER // 05.BIOMETRIC_POLYMER_CHASSIS",
                    icon: "solar:atom-bold-duotone",
                    metric: "9.8 g",
                    title: "Chassi em Polímero Anodizado Matte",
                    desc: "Corpo monobloco com centro de gravidade rebaixado em 14% e acabamento tátil matte anti-derrapante para conforto extremo em sessões longas.",
                    stat1: "9.8 Gramas",
                    stat2: "Grip Triangular",
                    stat3: "Clip Mola Aço"
                }
            ];

            window.selectAnatomyLayer = function(index) {
                const data = anatomyLayersData[index];
                if (!data) return;

                // Update UI active card states
                for (let i = 0; i < 5; i++) {
                    const card = document.getElementById(`layer-btn-${i}`);
                    if (card) {
                        if (i === index) {
                            card.className = "anatomy-layer-card p-5 sm:p-6 rounded-2xl border border-stone-900 dark:border-teal-400 bg-white dark:bg-stone-900 shadow-md cursor-pointer transition-all duration-300 translate-x-1";
                        } else {
                            card.className = "anatomy-layer-card p-5 sm:p-6 rounded-2xl border border-stone-300 dark:border-stone-800 bg-white/60 dark:bg-stone-900/60 cursor-pointer transition-all duration-300 hover:translate-x-1 hover:bg-white";
                        }
                    }
                }

                // Update HUD Telemetry
                const hudCode = document.getElementById('hud-layer-code');
                const hudIcon = document.getElementById('hud-main-icon');
                const hudMetric = document.getElementById('hud-main-metric');
                const hudTitle = document.getElementById('hud-layer-title');
                const hudDesc = document.getElementById('hud-layer-desc');
                const hudStat1 = document.getElementById('hud-stat-1');
                const hudStat2 = document.getElementById('hud-stat-2');
                const hudStat3 = document.getElementById('hud-stat-3');

                if (hudCode) hudCode.innerText = data.code;
                if (hudIcon) hudIcon.setAttribute('icon', data.icon);
                if (hudMetric) hudMetric.innerText = data.metric;
                if (hudTitle) hudTitle.innerText = data.title;
                if (hudDesc) hudDesc.innerText = data.desc;
                if (hudStat1) hudStat1.innerText = data.stat1;
                if (hudStat2) hudStat2.innerText = data.stat2;
                if (hudStat3) hudStat3.innerText = data.stat3;
            };


            // -------------------------------------------------------------
            // 4. Theme Toggle (Light / Dark Mode with System Memory)
            // -------------------------------------------------------------
            const themeToggleBtn = document.getElementById('theme-toggle');
            const themeIcon = document.getElementById('theme-icon');

            function applyTheme(isDark) {
                if (isDark) {
                    document.documentElement.classList.add('dark');
                    if (themeIcon) themeIcon.setAttribute('icon', 'solar:moon-linear');
                } else {
                    document.documentElement.classList.remove('dark');
                    if (themeIcon) themeIcon.setAttribute('icon', 'solar:sun-2-linear');
                }
                drawCurrentFrame();
            }

            const savedTheme = localStorage.getItem('artools-theme');
            if (savedTheme === 'dark') {
                applyTheme(true);
            } else {
                applyTheme(false);
            }

            if (themeToggleBtn) {
                themeToggleBtn.addEventListener('click', () => {
                    const isDark = document.documentElement.classList.toggle('dark');
                    applyTheme(isDark);
                    localStorage.setItem('artools-theme', isDark ? 'dark' : 'light');
                });
            }


            // -------------------------------------------------------------
            // 5. Interactive Drawing Slate Canvas
            // -------------------------------------------------------------
            const drawCanvas = document.getElementById('drawing-canvas');
            const drawPlaceholder = document.getElementById('drawing-placeholder');
            let drawCtx = null;
            let isDrawing = false;
            let currentPenWidth = 1.2;

            if (drawCanvas) {
                drawCtx = drawCanvas.getContext('2d');
                
                function resizeDrawCanvas() {
                    const rect = drawCanvas.parentElement.getBoundingClientRect();
                    const dpr = window.devicePixelRatio || 1;
                    drawCanvas.width = rect.width * dpr;
                    drawCanvas.height = rect.height * dpr;
                    drawCtx.scale(dpr, dpr);
                    drawCtx.lineCap = 'round';
                    drawCtx.lineJoin = 'round';
                    drawCtx.strokeStyle = document.documentElement.classList.contains('dark') ? '#FAF9F6' : '#1C1917';
                }

                window.addEventListener('resize', resizeDrawCanvas);
                resizeDrawCanvas();

                function getCanvasCoordinates(e) {
                    const rect = drawCanvas.getBoundingClientRect();
                    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                    return {
                        x: clientX - rect.left,
                        y: clientY - rect.top
                    };
                }

                function startDraw(e) {
                    isDrawing = true;
                    if (drawPlaceholder) drawPlaceholder.style.opacity = '0';
                    const pos = getCanvasCoordinates(e);
                    drawCtx.beginPath();
                    drawCtx.moveTo(pos.x, pos.y);
                    drawCtx.lineWidth = currentPenWidth;
                    drawCtx.strokeStyle = document.documentElement.classList.contains('dark') ? '#FAF9F6' : '#1C1917';
                }

                function moveDraw(e) {
                    if (!isDrawing) return;
                    e.preventDefault();
                    const pos = getCanvasCoordinates(e);
                    drawCtx.lineTo(pos.x, pos.y);
                    drawCtx.stroke();
                }

                function endDraw() {
                    isDrawing = false;
                    drawCtx.closePath();
                }

                drawCanvas.addEventListener('mousedown', startDraw);
                drawCanvas.addEventListener('mousemove', moveDraw);
                window.addEventListener('mouseup', endDraw);

                drawCanvas.addEventListener('touchstart', startDraw, { passive: false });
                drawCanvas.addEventListener('touchmove', moveDraw, { passive: false });
                window.addEventListener('touchend', endDraw);
            }

            window.setPenWidth = function(width) {
                currentPenWidth = width * 1.1;
                document.querySelectorAll('#pen-size-1, #pen-size-2, #pen-size-3, #pen-size-4').forEach(btn => {
                    btn.className = 'px-3.5 py-1.5 rounded-full bg-stone-100 dark:bg-stone-800 text-stone-800 dark:text-stone-300 text-xs font-mono hover:bg-stone-200 transition-all font-semibold';
                });
                if (event && event.currentTarget) {
                    event.currentTarget.className = 'px-3.5 py-1.5 rounded-full bg-[#1C1917] text-white dark:bg-teal-400 dark:text-stone-950 text-xs font-mono font-bold transition-all shadow-sm';
                }
            };

            window.clearCanvas = function() {
                if (!drawCanvas || !drawCtx) return;
                const dpr = window.devicePixelRatio || 1;
                drawCtx.clearRect(0, 0, drawCanvas.width / dpr, drawCanvas.height / dpr);
                if (drawPlaceholder) drawPlaceholder.style.opacity = '1';
            };

            // Watercolor Wash Simulator (Demonstrates 100% Waterproof Pigment)
            window.simulateWatercolorWash = function() {
                if (!drawCanvas || !drawCtx) return;
                if (drawPlaceholder) drawPlaceholder.style.opacity = '0';
                
                const dpr = window.devicePixelRatio || 1;
                const w = drawCanvas.width / dpr;
                const h = drawCanvas.height / dpr;

                // Save existing strokes
                const currentDrawing = drawCtx.getImageData(0, 0, drawCanvas.width, drawCanvas.height);

                // Draw translucent watercolor pigment blobs in the background
                drawCtx.save();
                drawCtx.globalCompositeOperation = 'destination-over';
                
                const colors = ['rgba(20, 184, 166, 0.22)', 'rgba(6, 182, 212, 0.18)', 'rgba(245, 158, 11, 0.15)'];
                for (let i = 0; i < 4; i++) {
                    const cx = Math.random() * w;
                    const cy = Math.random() * h;
                    const r = 60 + Math.random() * 90;
                    const grad = drawCtx.createRadialGradient(cx, cy, 10, cx, cy, r);
                    grad.addColorStop(0, colors[i % colors.length]);
                    grad.addColorStop(1, 'rgba(255, 255, 255, 0)');
                    drawCtx.fillStyle = grad;
                    drawCtx.beginPath();
                    drawCtx.arc(cx, cy, r, 0, Math.PI * 2);
                    drawCtx.fill();
                }
                drawCtx.restore();
            };

            // Export Sketch as PNG
            window.downloadSketch = function() {
                if (!drawCanvas) return;
                const link = document.createElement('a');
                link.download = `artools-sketch-${Date.now()}.png`;
                link.href = drawCanvas.toDataURL('image/png');
                link.click();
            };

            // -------------------------------------------------------------
            // 5.5 Live Swiss Clock Synchronizer (Geneva CET)
            // -------------------------------------------------------------
            function updateSwissClock() {
                const clockEl = document.getElementById('live-swiss-clock');
                if (clockEl) {
                    const now = new Date();
                    // Geneva CET Time (UTC+1 or UTC+2 depending on DST)
                    const options = { timeZone: 'Europe/Zurich', hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' };
                    const timeStr = now.toLocaleTimeString('pt-BR', options);
                    clockEl.innerText = `GENÈVE ${timeStr} CET`;
                }
            }
            setInterval(updateSwissClock, 1000);
            updateSwissClock();


            // -------------------------------------------------------------
            // 6. Order Modal Handlers
            // -------------------------------------------------------------
            window.openOrderModal = function() {
                const modal = document.getElementById('order-modal');
                const box = document.getElementById('order-modal-box');
                if (modal && box) {
                    modal.classList.remove('opacity-0', 'pointer-events-none');
                    box.classList.remove('scale-95');
                    box.classList.add('scale-100');
                }
            };

            window.closeOrderModal = function() {
                const modal = document.getElementById('order-modal');
                const box = document.getElementById('order-modal-box');
                if (modal && box) {
                    modal.classList.add('opacity-0', 'pointer-events-none');
                    box.classList.remove('scale-100');
                    box.classList.add('scale-95');
                }
            };

            const headerBuyBtn = document.getElementById('btn-header-buy');
            if (headerBuyBtn) {
                headerBuyBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    window.openOrderModal();
                });
            }


            // -------------------------------------------------------------
            // 7. Ambient Canvas Dot/Particle Physics Overlay
            // -------------------------------------------------------------
            const ambCanvas = document.getElementById('ambient-canvas');
            if (ambCanvas) {
                const aCtx = ambCanvas.getContext('2d');
                let aWidth, aHeight;
                let particles = [];

                function resizeAmb() {
                    aWidth = ambCanvas.width = window.innerWidth;
                    aHeight = ambCanvas.height = window.innerHeight;
                }
                window.addEventListener('resize', resizeAmb);
                resizeAmb();

                for (let i = 0; i < 30; i++) {
                    particles.push({
                        x: Math.random() * aWidth,
                        y: Math.random() * aHeight,
                        radius: Math.random() * 1.5 + 0.5,
                        vx: (Math.random() - 0.5) * 0.35,
                        vy: (Math.random() - 0.5) * 0.35
                    });
                }

                function drawAmbient() {
                    aCtx.clearRect(0, 0, aWidth, aHeight);
                    const isDark = document.documentElement.classList.contains('dark');
                    aCtx.fillStyle = isDark ? 'rgba(255, 255, 255, 0.18)' : 'rgba(28, 25, 23, 0.22)';

                    particles.forEach(p => {
                        p.x += p.vx;
                        p.y += p.vy;

                        if (p.x < 0) p.x = aWidth;
                        if (p.x > aWidth) p.x = 0;
                        if (p.y < 0) p.y = aHeight;
                        if (p.y > aHeight) p.y = 0;

                        aCtx.beginPath();
                        aCtx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                        aCtx.fill();
                    });

                    requestAnimationFrame(drawAmbient);
                }
                drawAmbient();
            }


            // -------------------------------------------------------------
            // 8. FPS Counter Meter
            // -------------------------------------------------------------
            let lastLoop = performance.now();
            let frameCount = 0;
            const fpsEl = document.getElementById('fps-counter');

            function calculateFps() {
                const currentLoop = performance.now();
                frameCount++;
                if (currentLoop > lastLoop + 1000) {
                    const fps = Math.round((frameCount * 1000) / (currentLoop - lastLoop));
                    if (fpsEl) fpsEl.innerText = `${fps} FPS`;
                    frameCount = 0;
                    lastLoop = currentLoop;
                }
                requestAnimationFrame(calculateFps);
            }
            requestAnimationFrame(calculateFps);

            // -------------------------------------------------------------
            // 9. GSAP ScrollTrigger Text & Micro-Transition Reveal Engine
            // -------------------------------------------------------------
            // Animate [data-reveal-text] elements
            document.querySelectorAll('[data-reveal-text]').forEach(el => {
                gsap.fromTo(el, 
                    { opacity: 0, y: 45, filter: 'blur(6px)' },
                    {
                        opacity: 1,
                        y: 0,
                        filter: 'blur(0px)',
                        duration: 1.1,
                        ease: 'power3.out',
                        scrollTrigger: {
                            trigger: el,
                            start: 'top 88%',
                            toggleActions: 'play none none none'
                        }
                    }
                );
            });

            // Animate [data-reveal-fade] text/badges
            document.querySelectorAll('[data-reveal-fade]').forEach(el => {
                gsap.fromTo(el, 
                    { opacity: 0, y: 25 },
                    {
                        opacity: 1,
                        y: 0,
                        duration: 0.9,
                        ease: 'power2.out',
                        scrollTrigger: {
                            trigger: el,
                            start: 'top 90%',
                            toggleActions: 'play none none none'
                        }
                    }
                );
            });

            // Animate [data-reveal-card] cards & pillars
            document.querySelectorAll('[data-reveal-card]').forEach((el) => {
                gsap.fromTo(el, 
                    { opacity: 0, y: 40, scale: 0.97 },
                    {
                        opacity: 1,
                        y: 0,
                        scale: 1.0,
                        duration: 1.0,
                        ease: 'power3.out',
                        scrollTrigger: {
                            trigger: el,
                            start: 'top 85%',
                            toggleActions: 'play none none none'
                        }
                    }
                );
            });

            // Initial Entrance reveal
            setTimeout(() => {
                const heroTitle = document.getElementById('hero-title');
                if (heroTitle) heroTitle.classList.add('reveal-active');
            }, 250);
        }

        // Executa no carregamento inicial e a cada troca de página com ClientRouter
        initIndexPage();
        document.addEventListener('DOMContentLoaded', initIndexPage);
        document.addEventListener('astro:page-load', initIndexPage);
        document.addEventListener('astro:before-swap', cleanupIndexPage);
    </script>
</body>
</html>
