---
import Button from '../components/Button.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TextType from '../components/TextType.astro';
import { Image } from 'astro:assets';
import canetaImg from '../assets/caneta.png';
import { ClientRouter } from 'astro:transitions';
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>ARTOOLS Pigmentum // A caneta mais tecnológica do mundo</title>
    <meta name="description" content="Descubra a ARTOOLS Pigmentum 0.1. A caneta mais tecnológica do mundo. Precisão cirúrgica, tinta pigmentada de alta fidelidade e ergonomia arquitetural." />
    <ClientRouter />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital@1&family=Inter:wght@200;300;400;500;600;700;800;900&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Tailwind Play CDN -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
                        mono: ['JetBrains Mono', 'Space Mono', 'monospace'],
                        display: ['Space Grotesk', 'Inter', 'sans-serif'],
                    },
                    colors: {
                        canvas: '#EAEAE5',
                        sand: {
                            50: '#FDFDFC',
                            100: '#F7F7F4',
                            200: '#EAEAE5',
                            300: '#DDDDD7',
                            400: '#C2C2B8',
                            500: '#9E9E94',
                            800: '#2C2C29',
                            900: '#1C1C1A',
                        },
                        stone: {
                            50: '#fafaf9',
                            100: '#f5f5f4',
                            200: '#e7e5e4',
                            300: '#d6d3d1',
                            400: '#a8a29e',
                            500: '#78716c',
                            600: '#57534e',
                            700: '#44403c',
                            800: '#292524',
                            900: '#1c1917',
                            950: '#0c0a09',
                        },
                        accent: {
                            coral: '#FF6347',
                            coralHover: '#FF4500',
                            teal: '#14B8A6',
                            emerald: '#10B981',
                            cyan: '#06B6D4',
                            acid: '#CCFF00',
                            amber: '#F59E0B',
                            rose: '#F43F5E'
                        }
                    },
                    animation: {
                        'spin-slow': 'spin 14s linear infinite',
                        'float': 'float 6s ease-in-out infinite',
                        'pulse-glow': 'pulse-glow 3s ease-in-out infinite',
                        'marquee': 'marquee 30s linear infinite',
                        'shimmer': 'shimmer 2.5s infinite',
                        'radar': 'radar 2s cubic-bezier(0, 0.2, 0.8, 1) infinite',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-8px)' }
                        },
                        'pulse-glow': {
                            '0%, 100%': { opacity: '0.4', transform: 'scale(1)' },
                            '50%': { opacity: '0.8', transform: 'scale(1.05)' }
                        },
                        marquee: {
                            '0%': { transform: 'translateX(0%)' },
                            '100%': { transform: 'translateX(-50%)' }
                        },
                        shimmer: {
                            '0%': { transform: 'translateX(-100%)' },
                            '100%': { transform: 'translateX(200%)' }
                        },
                        radar: {
                            '0%': { transform: 'scale(0.8)', opacity: '1' },
                            '100%': { transform: 'scale(2.4)', opacity: '0' }
                        }
                    }
                }
            }
        };
    </script>

    <!-- Iconify & Lucide Icons -->
    <script is:inline src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>

    <!-- GSAP & ScrollTrigger CDN -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>

    <!-- Lenis Smooth Scroll -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1.0.42/bundled/lenis.min.js"></script>

    <style>
        /* ============================================================
           THIAGO DESIGN SYSTEM - CORE ARCHITECTURAL TOKENS
        ============================================================ */
        :root {
            --bg-canvas: #EAEAE5;
            --bg-canvas-light: #F7F7F4;
            --bg-canvas-dark: #DDDDD7;
            --stone-950: #0C0A09;
            --stone-900: #1C1917;
            --stone-800: #292524;
            --stone-700: #44403C;
            --stone-500: #78716C;
            --stone-400: #A8A29E;
            --stone-300: #D6D3D1;
            --stone-200: #E7E5E4;
            --accent-teal: #14B8A6;
            --accent-coral: #FF6347;
            --glow-teal: rgba(20, 184, 166, 0.45);
            --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
            --ease-elastic: cubic-bezier(0.34, 1.56, 0.64, 1);
            --mouse-x: 50%;
            --mouse-y: 50%;
        }

        /* Dark Mode Theme Tokens */
        html.dark {
            --bg-canvas: #10100E;
            --bg-canvas-light: #181816;
            --bg-canvas-dark: #080807;
            --stone-950: #FFFFFF;
            --stone-900: #F5F5F4;
            --stone-800: #E7E5E4;
            --stone-700: #D6D3D1;
            --stone-500: #A8A29E;
            --stone-400: #78716C;
            --stone-300: #2C2C28;
            --stone-200: #1F1F1C;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-canvas);
            color: var(--stone-900);
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            transition: background-color 0.4s ease, color 0.4s ease;
        }

        /* High-End Architectural Grain / Paper Texture */
        .paper-grain-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 999;
            opacity: 0.04;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
            background-repeat: repeat;
        }
        html.dark .paper-grain-overlay {
            opacity: 0.025;
        }

        ::selection {
            background-color: #1C1917;
            color: #FAF9F6;
        }

        html.dark ::selection {
            background-color: #14B8A6;
            color: #000000;
        }

        /* Architectural Grid Overlay */
        .grid-guide-line {
            border-color: rgba(28, 25, 23, 0.08);
        }
        html.dark .grid-guide-line {
            border-color: rgba(255, 255, 255, 0.06);
        }

        /* Transparent Outline Lettering */
        .text-outline-dark {
            color: transparent;
            -webkit-text-stroke: 1.5px #1C1917;
        }
        html.dark .text-outline-dark {
            -webkit-text-stroke: 1.5px #F5F5F4;
        }

        .text-outline-white {
            color: transparent;
            -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.95);
        }

        .text-ghost {
            color: transparent;
            -webkit-text-stroke: 1px rgba(28, 25, 23, 0.08);
        }
        html.dark .text-ghost {
            -webkit-text-stroke: 1px rgba(255, 255, 255, 0.06);
        }

        /* Masked Text Reveal */
        .text-reveal-wrapper {
            overflow: hidden;
            display: inline-block;
            vertical-align: bottom;
        }
        .text-reveal-content {
            transform: translateY(110%);
            opacity: 0;
            transition: transform 1.1s var(--ease-out-expo), opacity 1.1s ease;
            display: block;
        }
        .reveal-active .text-reveal-content,
        .active .text-reveal-content,
        .loaded .text-reveal-content {
            transform: translateY(0);
            opacity: 1;
        }

        /* Glassmorphism Panels */
        .glass-panel-light {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.95);
        }
        html.dark .glass-panel-light {
            background: rgba(24, 24, 22, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.12);
        }

        .glass-panel-dark {
            background: rgba(18, 18, 18, 0.9);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255, 255, 255, 0.16);
        }

        /* Gemini Beam Button */
        .btn-beam {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 1.5px;
            border-radius: 9999px;
            overflow: hidden;
            transition: transform 0.35s var(--ease-elastic), box-shadow 0.35s ease;
        }
        .btn-beam:hover {
            transform: scale(1.03);
            box-shadow: 0 12px 30px -5px rgba(20, 184, 166, 0.45);
        }
        .btn-beam::before {
            content: "";
            position: absolute;
            inset: -150%;
            background: conic-gradient(from 0deg, transparent 0deg 300deg, #14B8A6 340deg, #5EEAD4 360deg);
            animation: spin 3s linear infinite;
        }

        /* Flashlight Card Track */
        .flashlight-card {
            position: relative;
            overflow: hidden;
        }
        .flashlight-card::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(
                420px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
                rgba(20, 184, 166, 0.2),
                transparent 60%
            );
            opacity: 0;
            transition: opacity 0.4s ease;
            pointer-events: none;
            z-index: 10;
        }
        .flashlight-card:hover::before {
            opacity: 1;
        }

        /* Ambient Background Canvas */
        #ambient-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 0;
            opacity: 0.35;
        }

        /* Fullscreen Hero Stage */
        .hero-fullscreen-stage {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            pointer-events: none;
            z-index: 5;
        }

        /* Hardware-Accelerated High-Performance Canvas */
        #pen-canvas {
            width: 100%;
            height: 100%;
            max-height: 94vh;
            object-fit: contain;
            pointer-events: none;
            will-change: transform;
            filter: drop-shadow(0 30px 50px rgba(0, 0, 0, 0.18));
            transform: translateZ(0);
        }

        /* Interactive Hotspots on the Pen */
        .hotspot-badge {
            position: absolute;
            z-index: 35;
            opacity: 0;
            transform: scale(0.9) translateY(12px);
            transition: opacity 0.45s var(--ease-out-expo), transform 0.45s var(--ease-out-expo);
            pointer-events: none;
        }
        .hotspot-badge.visible {
            opacity: 1;
            transform: scale(1) translateY(0);
            pointer-events: auto;
        }

        /* Play Button Pulse Ring */
        .play-btn-pulse::after {
            content: '';
            position: absolute;
            inset: -8px;
            border-radius: 9999px;
            border: 2px solid rgba(255, 99, 71, 0.5);
            animation: pulse-ring 2.5s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
        }
        @keyframes pulse-ring {
            0% { transform: scale(0.95); opacity: 0.8; }
            100% { transform: scale(1.4); opacity: 0; }
        }

        /* Cinematic Roll In / Roll Out Stage */
        .cinematic-roll-stage {
            will-change: transform, opacity, border-radius;
            transition: transform 0.6s var(--ease-out-expo), border-radius 0.6s ease;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 5px;
        }
        ::-webkit-scrollbar-track {
            background: #EAEAE5;
        }
        html.dark ::-webkit-scrollbar-track {
            background: #10100E;
        }
        ::-webkit-scrollbar-thumb {
            background: #A8A29E;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #FF6347;
        }

        /* Prefers-reduced-motion Accessibility */
        @media (prefers-reduced-motion: reduce) {
            *, ::before, ::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
                scroll-behavior: auto !important;
            }
            #pen-canvas {
                transition: none !important;
            }
        }
    </style>
</head>

<body class="min-h-screen relative pb-12 selection:bg-stone-900 selection:text-sand-50 dark:selection:bg-teal-500 dark:selection:text-stone-950">

    <!-- High-End Tactile Paper / Architectural Noise Texture Layer -->
    <div class="paper-grain-overlay" aria-hidden="true"></div>

    <!-- Ambient Physics Background Canvas -->
    <canvas id="ambient-canvas" aria-hidden="true"></canvas>

    <!-- Hidden Video Source for Buffer Decoding (Hero 3D Visualizer - 100% Muted) -->
    <video id="pen-video-source" preload="auto" muted playsinline webkit-playsinline class="hidden" style="display:none;" volume="0">
        <source src="./assets/video/video2.mp4" type="video/mp4" />
    </video>

    <!-- Main Architectural Frame Wrapper -->
    <div class="max-w-[1536px] mx-auto border-x border-stone-300 dark:border-stone-800 relative bg-[#EAEAE5]/95 dark:bg-[#10100E]/95 shadow-2xl z-10 transition-colors duration-400">

        <!-- Architectural Vertical Guide Lines Overlay -->
        <div class="absolute inset-0 pointer-events-none grid grid-cols-1 md:grid-cols-12 gap-0 z-0 h-full w-full" aria-hidden="true">
            <div class="hidden md:block md:col-span-3 border-r grid-guide-line h-full"></div>
            <div class="hidden md:block md:col-span-6 border-r grid-guide-line h-full"></div>
            <div class="hidden md:block md:col-span-3 h-full"></div>
        </div>

        <Header transition:persist />


        <!-- ============================================================
             DOBRA PRINCIPAL: HERO FULLSCREEN COM TEXTO COMPACTO À ESQUERDA
             - O vídeo video2.mp4 tem o primeiro segundo cortado (inicia em 1.0s)
             - Tipografia compacta e de alto contraste à esquerda
             - Vídeo/Canvas centralizado com rotação fluida 60 FPS
             - Botão Play interativo circular coral/laranja
        ============================================================ -->
        <section id="scroll-hero-section" class="relative z-10 w-full" style="height: 420vh;">
            
            <!-- Sticky Viewport Stage (Fixo na tela ocupando 100vh) -->
            <div id="hero-sticky-stage" class="sticky top-0 h-screen w-full flex flex-col justify-between overflow-hidden border-b border-stone-300 dark:border-stone-800">
                
                <!-- ========================================================
                     1. CANVAS FULLSCREEN CENTRAL (O Vídeo da caneta iniciando após 1.0s)
                ======================================================== -->
                <div class="hero-fullscreen-stage">
                    
                    <!-- Ambient Radial Glow Backdrop atrás da caneta -->
                    <div class="absolute inset-0 flex items-center justify-center pointer-events-none" aria-hidden="true">
                        <div class="w-[500px] sm:w-[900px] h-[500px] sm:h-[900px] rounded-full bg-stone-300/40 dark:bg-stone-800/40 blur-3xl animate-pulse-glow"></div>
                    </div>

                    <!-- The High-Performance Canvas Element with Instant Fallback -->
                    <canvas id="pen-canvas" data-fallback-src={canetaImg.src} aria-label="Visualizador 3D fluido de alta performance da caneta ARTOOLS Pigmentum"></canvas>

                    <!-- ========================================================
                         DYNAMIC HOTSPOT CALLOUTS (Aparecem durante o scroll)
                    ======================================================== -->
                    <!-- Hotspot 1: 0.1mm Tip (Visible around 18% - 42% scroll) -->
                    <div id="hotspot-tip" class="hotspot-badge top-24 left-6 sm:top-28 sm:left-14 md:left-24 glass-panel-light dark:glass-panel-dark p-4 rounded-2xl shadow-2xl max-w-[240px] border border-stone-300 dark:border-stone-700">
                        <div class="flex items-center gap-1.5 text-stone-900 dark:text-teal-400 text-[10px] font-mono uppercase font-bold mb-1">
                            <span class="w-2 h-2 rounded-full bg-stone-900 dark:bg-teal-400 animate-ping"></span>
                            01 // PONTA CIRÚRGICA
                        </div>
                        <div class="text-sm font-bold text-stone-900 dark:text-white font-display">Ponta de Aço 0.1mm</div>
                        <p class="text-xs text-stone-600 dark:text-stone-400 mt-1 leading-relaxed">Micro-esfera calibrada para fluxo ininterrupto de tinta em réguas e gabaritos.</p>
                    </div>

                    <!-- Hotspot 2: Waterbase Pigment Ink (Visible around 45% - 72% scroll) -->
                    <div id="hotspot-ink" class="hotspot-badge bottom-24 left-6 sm:bottom-28 sm:left-14 md:left-24 glass-panel-light dark:glass-panel-dark p-4 rounded-2xl shadow-2xl max-w-[250px] border border-stone-300 dark:border-stone-700">
                        <div class="flex items-center gap-1.5 text-stone-900 dark:text-teal-400 text-[10px] font-mono uppercase font-bold mb-1">
                            <iconify-icon icon="solar:waterdrops-bold-duotone"></iconify-icon>
                            02 // TINTA PIGMENTADA
                        </div>
                        <div class="text-sm font-bold text-stone-900 dark:text-white font-display">Fórmula Pigmentum™</div>
                        <p class="text-xs text-stone-600 dark:text-stone-400 mt-1 leading-relaxed">À prova d'água, secagem rápida e resistência a raios UV para grau arquivístico.</p>
                    </div>

                    <!-- Hotspot 3: Ergonomic Body & Clip (Visible around 75% - 98% scroll) -->
                    <div id="hotspot-clip" class="hotspot-badge top-24 right-6 sm:top-28 sm:right-14 md:right-24 glass-panel-light dark:glass-panel-dark p-4 rounded-2xl shadow-2xl max-w-[240px] border border-stone-300 dark:border-stone-700">
                        <div class="flex items-center gap-1.5 text-stone-900 dark:text-amber-400 text-[10px] font-mono uppercase font-bold mb-1">
                            <iconify-icon icon="solar:shield-check-bold"></iconify-icon>
                            03 // CORPO ESTRUTURAL
                        </div>
                        <div class="text-sm font-bold text-stone-900 dark:text-white font-display">Polímero Matte Puro</div>
                        <p class="text-xs text-stone-600 dark:text-stone-400 mt-1 leading-relaxed">Clip de aço temperado e equilíbrio de peso milimétrico para conforto absoluto.</p>
                    </div>
                </div>


                <!-- ========================================================
                     2. OVERLAY SUPERIOR DISCRETO
                ======================================================== -->
                <div class="relative z-30 px-6 sm:px-12 md:px-16 pt-6 pb-2 flex justify-between items-center pointer-events-auto">
                    <div></div>

                    <!-- Telemetry Percentage HUD -->
                    <div class="flex items-center gap-3 bg-white/80 dark:bg-stone-900/80 backdrop-blur-md px-3.5 py-1.5 rounded-full border border-stone-300 dark:border-stone-700 shadow-sm">
                        <span class="text-[10px] font-mono text-stone-700 dark:text-stone-400 uppercase tracking-widest font-semibold">360° VIEW:</span>
                        <span id="telemetry-percentage" class="text-xs font-mono font-bold text-stone-950 dark:text-teal-400">000%</span>
                    </div>
                </div>


                <!-- ========================================================
                     3. TEXTO COMPACTO À ESQUERDA (DESIGN SYSTEM THIAGO - 100% LEGÍVEL)
                ======================================================== -->
                <div class="relative z-20 flex-1 flex items-center px-6 sm:px-12 md:px-16 pointer-events-none">
                    
                    <!-- Left Compact Container -->
                    <div id="hero-left-content" class="max-w-md xl:max-w-lg pointer-events-auto transition-all duration-500 text-left">
                        
                        <!-- ● PRECISION SERIES Tag -->
                        <div class="flex items-center gap-2 mb-4 sm:mb-6">
                            <span class="w-2.5 h-2.5 rounded-full bg-[#1C1917]"></span>
                            <span class="text-xs font-mono uppercase tracking-widest text-[#1C1917] font-bold">PRECISION SERIES</span>
                        </div>

                        <!-- Monumental Compact Headline (Exact Thiago Design System Specs) -->
                        <h1 class="reveal-active text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tighter leading-[0.98] mb-5 font-display text-[#1C1917]" id="hero-title">
                            <span class="text-reveal-wrapper block">
                                <span class="text-reveal-content text-[#1C1917]">A caneta</span>
                            </span>
                            <span class="text-reveal-wrapper block">
                                <span class="text-reveal-content text-outline-dark font-light" style="-webkit-text-stroke: 1.5px #1C1917; color: transparent;">mais tecnológica</span>
                            </span>
                            <span class="text-reveal-wrapper block">
                                <span class="text-reveal-content text-[#1C1917]">do mundo.</span>
                            </span>
                        </h1>

                        <!-- Compact Description -->
                        <p id="hero-desc" class="text-xs sm:text-sm md:text-[15px] text-[#44403C] leading-relaxed mb-8 font-sans max-w-sm font-normal">
                            A Artools Precision Pen redefine o equilíbrio entre peso, fluxo e design. Feita para criadores que exigem perfeição em cada traço.
                        </p>

                        <!-- Action Buttons Row (Design System Thiago Standards) -->
                        <div id="hero-cta-group" class="flex flex-wrap items-center gap-3 sm:gap-4">
                            <!-- Primary Black Button: Comprar Agora / Catálogo -->
                            <Button href="/pagina2">Comprar Agora</Button>

                            <!-- Secondary Pill Button: Explorar ↓ -->
                            <Button href="#video-showcase-section" variant="secondary">Explorar <iconify-icon icon="solar:arrow-down-linear" class="text-sm"></iconify-icon></Button>
                        </div>

                    </div>

                    <!-- Right-Side Navigation Indicator -->
                    <div class="absolute right-6 sm:right-12 top-1/2 -translate-y-1/2 flex flex-col items-center gap-4 text-[#57534E] pointer-events-auto hidden md:flex">
                        <a href="#main-header" class="text-[11px] font-mono tracking-widest uppercase hover:text-[#1C1917] flex items-center gap-1 font-bold">
                            <iconify-icon icon="solar:arrow-up-linear"></iconify-icon> PREV
                        </a>
                        <div class="w-px h-16 bg-stone-400/80 relative">
                            <div id="vertical-scroll-tick" class="w-1.5 h-1.5 rounded-full bg-[#1C1917] -left-[2.5px] absolute top-0 transition-all duration-100"></div>
                        </div>
                        <span class="text-sm font-mono font-bold text-[#1C1917]">01</span>
                    </div>

                </div>


                <!-- ========================================================
                     4. BARRA INFERIOR COM DETALHE CORAL
                ======================================================== -->
                <div class="relative z-30 pointer-events-auto">
                    <!-- Accent Progress Line across bottom -->
                    <div class="w-full h-1 bg-stone-300 dark:bg-stone-800 relative">
